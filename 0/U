FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}


dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (6.363 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform (6.363 0 0);
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (6.363 0 0);
    }

    blades
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    nonCouple
    {
        type            movingWallSlipVelocity;
        value           uniform (6.363 0 0);
    }
}
